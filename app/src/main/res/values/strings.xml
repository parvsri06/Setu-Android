    <string name="consent_title">What Setu does</string>
    <string name="consent_body_1">Setu carries short messages from phone to phone over Bluetooth when there is no network.</string>
    <string name="consent_body_2">Your phone will also carry other people\'s messages. They are encrypted. Your phone cannot read them.</string>
    <string name="consent_body_3">Your location is sent only inside an SOS, and only a rescuer can open it.</string>
    <string name="consent_purpose">Used only to pass emergency messages. Messages are deleted when they expire. You can stop the relay at any time.</string>
    <string name="consent_agree">I understand and agree</string>

