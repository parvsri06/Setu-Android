    <string name="consent_title">What Setu does</string>
    <string name="consent_body_1">Setu carries short messages from phone to phone over Bluetooth when there is no network.</string>
    <string name="consent_body_2">Your phone will also carry other people\'s messages. They are encrypted. Your phone cannot read them.</string>
    <string name="consent_body_3">Your location is sent only inside an SOS, and only a rescuer can open it.</string>
    <string name="consent_purpose">Used only to pass emergency messages. Messages are deleted when they expire. You can stop the relay at any time.</string>
    <string name="consent_agree">I understand and agree</string>

    <string name="perm_title">Permissions</string>
    <string name="perm_body">Setu needs Bluetooth to find nearby phones, and location to attach a position to your SOS.</string>
    <string name="perm_grant">Grant permissions</string>
    <string name="perm_missing">Some permissions are missing. The relay cannot run without them.</string>
    <string name="perm_granted">All permissions granted</string>

    <string name="battery_title">Keep Setu running</string>
    <string name="battery_body">Many phones stop background apps to save power. Setu must keep running with the screen off. Please allow it to run without restrictions.</string>
    <string name="battery_open">Open battery settings</string>
    <string name="battery_skip">Skip for now</string>
