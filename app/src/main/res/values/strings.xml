    <!-- Rescuer demo -->
    <string name="rescuer_title">Rescuer view (demo)</string>
    <string name="rescuer_body">This screen uses a demo rescuer key that ships inside the app, so it can open what this phone sealed. In a real deployment that key would exist only on a rescuer device.</string>
