    <string name="consent_title">Setu क्या करता है</string>
    <string name="consent_body_1">जब नेटवर्क नहीं होता, Setu छोटे संदेश ब्लूटूथ से एक फ़ोन से दूसरे फ़ोन तक पहुँचाता है।</string>
    <string name="consent_body_2">आपका फ़ोन दूसरों के संदेश भी ले जाएगा। वे एन्क्रिप्टेड हैं। आपका फ़ोन उन्हें पढ़ नहीं सकता।</string>
    <string name="consent_body_3">आपका स्थान केवल SOS के अंदर भेजा जाता है, और उसे केवल बचावकर्मी ही खोल सकता है।</string>
    <string name="consent_purpose">इसका उपयोग केवल आपातकालीन संदेश भेजने के लिए होता है। समय पूरा होने पर संदेश मिटा दिए जाते हैं। आप रिले कभी भी रोक सकते हैं।</string>
    <string name="consent_agree">मैं समझ गया और सहमत हूँ</string>

    <string name="perm_title">अनुमतियाँ</string>
    <string name="perm_body">पास के फ़ोन खोजने के लिए Setu को ब्लूटूथ चाहिए, और आपके SOS में स्थान जोड़ने के लिए लोकेशन चाहिए।</string>
    <string name="perm_grant">अनुमति दें</string>
    <string name="perm_missing">कुछ अनुमतियाँ नहीं मिलीं। उनके बिना रिले नहीं चल सकता।</string>
    <string name="perm_granted">सभी अनुमतियाँ मिल गईं</string>

    <string name="battery_title">Setu को चलता रखें</string>
    <string name="battery_body">कई फ़ोन बैटरी बचाने के लिए पृष्ठभूमि ऐप बंद कर देते हैं। स्क्रीन बंद होने पर भी Setu का चलते रहना ज़रूरी है। कृपया इसे बिना रोक-टोक चलने दें।</string>
    <string name="battery_open">बैटरी सेटिंग खोलें</string>
